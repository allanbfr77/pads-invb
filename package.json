{
  "name": "pads-igreja",
  "version": "2.0.0",
  "description": "Pads ambiente para igreja: o PC toca o áudio, o celular do tecladista controla.",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "dist": "electron-builder",
    "test": "node smoke-test.js"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "build": {
    "appId": "br.igreja.pads",
    "productName": "Pads Igreja",
    "files": ["server.js", "main.js", "player.html", "remote.html", "engine.js", "manifest.webmanifest", "sw.js", "icon.svg", "config.json", "package.json"],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" }
  }
}
